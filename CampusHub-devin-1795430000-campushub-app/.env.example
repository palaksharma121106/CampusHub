# Copy to .env (never commit .env). Used by docker compose and by the backend (backend/.env also works).
MYSQL_PASSWORD=campushub
MYSQL_ROOT_PASSWORD=change-me-root
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Optional: Google Gemini key for generated answers. Leave empty to use extractive (quote-only) answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FIRST_ADMIN_EMAIL=admin@campushub.demo
FIRST_ADMIN_PASSWORD=Admin@12345
