# Local development (python -m uvicorn app.main:app --reload). Copy to backend/.env.
DATABASE_URL=mysql+pymysql://campushub:campushub@localhost:3306/campushub
JWT_SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=20
COLLEGE_NAME=Demo Institute of Technology
